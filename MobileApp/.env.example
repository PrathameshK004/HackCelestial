# Live backend API URL for Triptual Mobile App
EXPO_PUBLIC_API_URL=https://hackcelestial-api.onrender.com/api

# Free-to-start map stack: keep the style provider configurable and avoid hard-coded Google dependencies.
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_STYLE_DARK_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_STYLE_SATELLITE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
