# Database Configuration (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT Auth Secret
JWTSecret=your_secure_jwt_secret_key_here
# Must match the dashboard backend's JWT_SECRET for admin ticket access and sockets.
ADMIN_JWT_SECRET=your_dashboard_jwt_secret_here

# Google Identity Services OAuth client
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Server Port
PORT=4000

# Comma-separated allowed dashboard origins; the deployed Triptual dashboard is allowed by default.
ADMIN_FRONTEND_URL=https://triptual-admin-dashboard-7gca.vercel.app

# Email Delivery Configuration (Direct Gmail SMTP)
EMAIL=your.support.email@gmail.com
EMAIL_PASSWORD=your_google_app_password

# Test / Fallback Service
TEST_TOKEN=your_test_token
EMAIL_SERVICE_API=your_email_service_api_key
EMAIL_SERVICE_URL=https://email-service-delta-seven.vercel.app/api/send-email

# AWS S3 Profile Picture Uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Dine / Restaurant Provider Configuration
RESTAURANT_PROVIDER=fallback
RESTAURANT_PROVIDER_API_KEY=
RESTAURANT_PROVIDER_BASE_URL=
DINE_CACHE_TTL=900
DINE_SEARCH_MAX_RADIUS=25000
DINE_MAX_PAGE_SIZE=50
