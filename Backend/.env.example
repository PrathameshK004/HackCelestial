# Database Configuration (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT Auth Secret
JWTSecret=your_secure_jwt_secret_key_here

# Server Port
PORT=4000

# Email Delivery Configuration (Direct Gmail SMTP)
EMAIL=your.support.email@gmail.com
EMAIL_PASSWORD=your_google_app_password

# Test / Fallback Service
TEST_TOKEN=your_test_token
EMAIL_SERVICE_API=your_email_service_api_key
EMAIL_SERVICE_URL=https://email-service-delta-seven.vercel.app/api/send-email
